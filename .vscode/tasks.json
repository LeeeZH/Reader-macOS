{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "./build.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "swift",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "./test.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "run",
      "type": "shell",
      "command": "./run.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "run (console)",
      "type": "shell",
      "command": "./run.sh --console",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "run with GBK sample",
      "type": "shell",
      "command": "./dist/Reader.app/Contents/MacOS/Reader ./samples/GBK样例.txt",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "run with long sample",
      "type": "shell",
      "command": "./dist/Reader.app/Contents/MacOS/Reader ./samples/长篇小说样例.txt",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build",
      "problemMatcher": []
    }
  ]
}
